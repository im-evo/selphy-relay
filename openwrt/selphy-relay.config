config relay 'main'
	# 0 to disable
	option enabled '1'
	# Address and port the relay listens on (also serves the status page)
	option listen ':8631'
	# Printer is found via mDNS: first printer whose name or model contains this text
	option match 'SELPHY'
	# Or set a fixed address, e.g. '10.0.0.184:631' (leave empty to discover)
	option printer ''
	# LAN interface to search on
	option iface 'br-lan'
	# jpeg = convert iPhone raster (URF) to JPEG (recommended for SELPHY CP1200)
	# patch = only cap print quality; off = pass documents through unchanged
	option mode 'jpeg'
	option jpeg_quality '95'
	# Max print-quality to send; 0 = whatever the printer reports it supports
	option quality '0'
	# Name shown on phones; empty = "<printer name> Relay"
	option name ''
