#!/bin/sh /etc/rc.common
# selphy-relay: AirPrint relay. Settings: /etc/config/selphy-relay
START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled listen printer match iface mode jpeg_quality quality name
	config_load selphy-relay
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get listen main listen ':8631'
	config_get printer main printer ''
	config_get match main match 'SELPHY'
	config_get iface main iface 'br-lan'
	config_get mode main mode 'jpeg'
	config_get jpeg_quality main jpeg_quality '95'
	config_get quality main quality '0'
	config_get name main name ''

	procd_open_instance
	procd_set_param command /usr/bin/selphy-relay -listen "$listen" -match "$match" -iface "$iface" \
		-mode "$mode" -jpeg-quality "$jpeg_quality" -quality "$quality" -avahi-dir /etc/avahi/services
	[ -n "$printer" ] && procd_append_param command -printer "$printer"
	[ -n "$name" ] && procd_append_param command -name "$name"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /etc/avahi/services/selphy-relay.service
	killall -HUP avahi-daemon 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger selphy-relay
}
